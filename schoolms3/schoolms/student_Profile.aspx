<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="student_Profile.aspx.cs" Inherits="schoolms.student_Profile" %>
<!DOCTYPE html><html><head runat="server"><title>Student Profile</title><meta name="viewport" content="width=device-width, initial-scale=1"/><style>body{font-family:Segoe UI,Arial;margin:0;background:#f4f7fb}.wrap{max-width:1000px;margin:30px auto;padding:20px}.top,.card{background:#fff;border-radius:14px;padding:22px;box-shadow:0 5px 18px rgba(0,0,0,.08);margin-bottom:20px}.top{background:#1a2a6c;color:#fff}.top a{color:#1a2a6c;background:#fff;padding:9px 14px;border-radius:8px;text-decoration:none}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:15px}.item{padding:16px;border:1px solid #e5e7eb;border-radius:10px}</style></head><body><form id="form1" runat="server"><div class="wrap"><div class="top"><h1>Student Profile</h1><asp:Literal ID="litWelcome" runat="server"/><p><a href="student_Dashboard.aspx">← Dashboard</a></p></div><div class="card"><div class="grid"><div class="item"><b>Enrollment No.</b><br/><asp:Literal ID="litEnrl" runat="server"/></div><div class="item"><b>Name</b><br/><asp:Literal ID="litName" runat="server"/></div><div class="item"><b>Age</b><br/><asp:Literal ID="litAge" runat="server"/></div><div class="item"><b>City</b><br/><asp:Literal ID="litCity" runat="server"/></div><div class="item"><b>Class</b><br/><asp:Literal ID="litClass" runat="server"/></div></div></div></div></form></body></html>
